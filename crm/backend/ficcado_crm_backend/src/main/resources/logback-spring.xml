<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true">
    <!-- Register AUD-13 PII & Secret Masking Converter -->
    <conversionRule conversionWord="mask" converterClass="com.aps.ficcado_crm_backend.logging.PiiMaskingConverter" />

    <property name="CONSOLE_LOG_PATTERN"
              value="%clr(%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}){faint} %clr(%5p) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %mask(%m)%n%wEx" />

    <include resource="org/springframework/boot/logging/logback/defaults.xml" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>

    <!-- Silence excessive noise from external libraries -->
    <logger name="org.apache.catalina" level="WARN" />
    <logger name="org.hibernate.validator" level="WARN" />
</configuration>
