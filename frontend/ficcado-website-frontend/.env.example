# =============================================================================
# Ficcado Clothing — Environment Variables Example
# Duplicate this file to .env.local for local development, or configure in Vercel Project Settings
# =============================================================================

# 1. WhatsApp Ordering (Official Line)
# International format digits only (no +, no dashes, no spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=916282000729

# 2. Public Storefront URL (Required for canonical URLs & OG metadata)
NEXT_PUBLIC_SITE_URL=https://ficcado.in

# 3. Privacy Contact Email (Required for GDPR/DPDP notices & builds per D15)
NEXT_PUBLIC_PRIVACY_EMAIL=ficcado.clothing@gmail.com

# 4. Google Sheets Database (Target Spreadsheet: 1U1bdFZH68Seg3OcV3Wtucmsqg8JL5i3MIGECglu_hfs)
GOOGLE_SHEET_ID=1U1bdFZH68Seg3OcV3Wtucmsqg8JL5i3MIGECglu_hfs

# Google Cloud Service Account Authentication (RS256 JWT)
GOOGLE_SERVICE_ACCOUNT_EMAIL=ficcado-quick-webapp@ficcado-quick-website.iam.gserviceaccount.com
# Multi-line PEM or \n-escaped private key string
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional local path to service account key file (fallback for local dev)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=../credentials/ficcado-quick-website-5fc91a2f02ba.json

# 5. Order Dispatch Gateway per D1
# Either set ORDER_GATEWAY_URL + ORDER_GATEWAY_SECRET or explicitly set ORDER_ID_MODE=sheet-row
ORDER_GATEWAY_URL=https://script.google.com/macros/s/AKfycb.../exec
ORDER_GATEWAY_SECRET=replace-with-your-apps-script-secret-token
ORDER_ID_MODE=sheet-row

# 6. Rate Limiting per D2
# Set RATE_LIMIT_STORE=upstash or RATE_LIMIT_STORE=memory
RATE_LIMIT_STORE=memory
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# 7. System & Operational Settings
ORDER_ID_LIMIT=9999
SHEETS_STRICT=false
ADMIN_TOKEN=ficcado-admin-secure-token
