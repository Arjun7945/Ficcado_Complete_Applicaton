# =============================================================================
# Ficcado Infrastructure Environment Configuration (.env.example)
# Copy this file to 'infra/.env' and configure your local passwords.
# DO NOT commit 'infra/.env' to version control.
# =============================================================================

# --- PostgreSQL (Host port 5433) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=choose_secure_postgres_root_password
POSTGRES_DB=postgres

# Service Databases & Credentials
WEBSITE_DB_NAME=ficcado_website_data
WEBSITE_DB_USER=ficcado_website_user
WEBSITE_DB_PASSWORD=choose_website_db_password

PAYMENT_DB_NAME=ficcado_payment_gateway_data
PAYMENT_DB_USER=ficcado_payment_user
PAYMENT_DB_PASSWORD=choose_payment_db_password

# Test Databases & Credentials (Least Privilege)
TEST_CRM_DB_NAME=ficcado_data_test
TEST_WEBSITE_DB_NAME=ficcado_website_data_test
TEST_PAYMENT_DB_NAME=ficcado_payment_gateway_data_test
TEST_DB_USER=ficcado_test_user
TEST_DB_PASSWORD=choose_test_db_password

# --- Redis Session (Host port 6380, noeviction) ---
REDIS_SESSION_PASSWORD=choose_redis_session_password

# --- Redis Cache (Host port 6379, allkeys-lru) ---
REDIS_CACHE_PASSWORD=choose_redis_cache_password
REDIS_CACHE_MAXMEMORY=256mb

# --- RabbitMQ (Host ports 5672, 15672) ---
RABBITMQ_USER=ficcado_rabbit
RABBITMQ_PASSWORD=choose_rabbitmq_password

# --- Gateway Upstreams (NGINX -> Host Services) ---
FICCADO_DATA_UPSTREAM=host.docker.internal:8081
WEBSITE_DATA_UPSTREAM=host.docker.internal:8082
PAYMENT_DATA_UPSTREAM=host.docker.internal:8083

# --- Monitoring (Optional profile: monitoring) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=choose_grafana_admin_password
